[Unit]
Description=Anonimka payment webhook and scheduler
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=codexops
Group=codexops
WorkingDirectory=/opt/anonimka
EnvironmentFile=/etc/anonimka/anonimka.env
Environment="PATH=/opt/anonimka/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONPATH=/opt/anonimka"
Environment="PORT=8002"
ExecStart=/opt/anonimka/venv/bin/python3 /opt/anonimka/main.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target

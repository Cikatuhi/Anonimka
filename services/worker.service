[Unit]
Description=Telegram Bot Worker (рассылки)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/Anonimno-Artem-
ExecStart=/root/Anonimno-Artem-/venv/bin/python3 /root/Anonimno-Artem-/worker.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target